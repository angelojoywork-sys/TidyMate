rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // The shape every house document must keep (size limits stop abuse).
    function validHouse(d) {
      return d.keys().hasOnly(['home','members','chores','log','streak','best','updated','ownerUid','memberUids','inviteCode','joinCode'])
        && d.home is string && d.home.size() <= 40
        && d.members is list && d.members.size() >= 1 && d.members.size() <= 4
        && d.chores is list && d.chores.size() <= 60
        && d.log is list && d.log.size() <= 100
        && d.ownerUid is string
        && d.memberUids is list && d.memberUids.size() >= 1 && d.memberUids.size() <= 8
        && d.inviteCode is string && d.inviteCode.size() >= 20;
    }

    // A house is private to the people in memberUids. The only way in is the secret invite code.
    match /houses/{houseId} {
      // resource == null lets the app ask "does this house exist yet?" without revealing anything.
      allow get: if signedIn() && (resource == null || request.auth.uid in resource.data.memberUids);
      allow list: if false;

      allow create: if signedIn()
        && houseId.size() >= 20
        && validHouse(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid];

      allow update: if signedIn() && (
        // 1. A member edits the house. The member list can only shrink: the owner removes anyone, anyone removes only themselves.
        (request.auth.uid in resource.data.memberUids
          && validHouse(request.resource.data)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && (request.resource.data.inviteCode == resource.data.inviteCode || request.auth.uid == resource.data.ownerUid)
          && (request.resource.data.memberUids == resource.data.memberUids
              || (resource.data.memberUids.hasAll(request.resource.data.memberUids)
                  && (request.auth.uid == resource.data.ownerUid
                        ? request.auth.uid in request.resource.data.memberUids
                        : (!(request.auth.uid in request.resource.data.memberUids)
                           && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1)))))
        ||
        // 2. Someone joins. They change nothing except adding their own ID, and must show the current invite code.
        (!(request.auth.uid in resource.data.memberUids)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids','joinCode','updated'])
          && request.resource.data.joinCode == resource.data.inviteCode
          && request.resource.data.memberUids == resource.data.memberUids.concat([request.auth.uid])
          && request.resource.data.memberUids.size() <= 8)
      );

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // An invite is a public note that says which house a secret code opens. Nobody can list invites.
    match /invites/{code} {
      allow get: if code.size() >= 20;
      allow list: if false;
      allow create: if signedIn()
        && code.size() >= 20
        && request.resource.data.keys().hasOnly(['houseId','home','createdBy'])
        && request.resource.data.houseId is string
        && request.resource.data.home is string && request.resource.data.home.size() <= 40
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in getAfter(/databases/$(database)/documents/houses/$(request.resource.data.houseId)).data.memberUids;
      allow update: if false;
      allow delete: if signedIn()
        && get(/databases/$(database)/documents/houses/$(resource.data.houseId)).data.ownerUid == request.auth.uid;
    }

    // Your own profile: first name and the houses you belong to. Nobody else can read it.
    match /users/{userId} {
      allow read, delete: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name','houses','createdAt'])
        && request.resource.data.houses is list && request.resource.data.houses.size() <= 10
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 24));
    }
  }
}
