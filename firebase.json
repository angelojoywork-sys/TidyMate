{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", ".firebaserc", "**/.*", "**/node_modules/**", "docs/**", "firebase/**", "*.md", "package*.json"],
    "headers": [
      {"source": "**/*.@(woff2|png|svg)", "headers": [{"key": "Cache-Control", "value": "public, max-age=604800"}]},
      {"source": "/index.html", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}
    ]
  },
  "firestore": {
    "rules": "firebase/firestore.rules"
  }
}
